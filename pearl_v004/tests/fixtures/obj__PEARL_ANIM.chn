    channel flicker {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = "import math
from statistics import NormalDist
n = hou.pwd()
st = n.evalParm(\"loop_start\"); lf = max(1.0, n.evalParm(\"loop_frames\"))
loopsec = lf / hou.fps()
seed = n.evalParm(\"seed\")
def ln(f, cycles, s):
    # noise sampled around a circle: returns to its start value after one loop
    u = ((f - st) / lf) % 1.0
    a = u * 2.0 * math.pi
    r = cycles / (2.0 * math.pi)
    return hou.hmath.noise1d([math.cos(a) * r, math.sin(a) * r, s * 13.37 + 0.5])
def thr(share):
    # noise1d is ~normal(0.5, 0.104): threshold exceeded `share` of the time
    share = min(max(share, 1e-4), 1.0 - 1e-4)
    return 0.5 + 0.104 * NormalDist().inv_cdf(1.0 - share)
def ss(e0, e1, x):
    t = min(max((x - e0) / (e1 - e0), 0.0), 1.0)
    return t * t * (3.0 - 2.0 * t)
if not n.evalParm(\"enable\"):
    return 0.0
f0 = hou.frame()
cov = n.evalParm(\"coverage\")
if cov <= 0.0:
    return 0.0
t0 = thr(cov)
gate = ss(t0, t0 + 0.02, ln(f0, max(1.0, round(n.evalParm(\"burst_rate\") * loopsec)), seed))
if gate <= 0.0:
    return 0.0
hzc = max(1.0, round(n.evalParm(\"stutter_hz\") * loopsec))
on = 1.0 if ln(f0, hzc, seed + 7.1) > thr(n.evalParm(\"stutter_on\")) else 0.0
bright = 0.55 + 0.45 * ss(0.35, 0.65, ln(f0, hzc * 0.37, seed + 3.3))
return gate * on * bright
" language = python }
    }
    channel gate {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = "import math
from statistics import NormalDist
n = hou.pwd()
st = n.evalParm(\"loop_start\"); lf = max(1.0, n.evalParm(\"loop_frames\"))
loopsec = lf / hou.fps()
seed = n.evalParm(\"seed\")
def ln(f, cycles, s):
    # noise sampled around a circle: returns to its start value after one loop
    u = ((f - st) / lf) % 1.0
    a = u * 2.0 * math.pi
    r = cycles / (2.0 * math.pi)
    return hou.hmath.noise1d([math.cos(a) * r, math.sin(a) * r, s * 13.37 + 0.5])
def thr(share):
    # noise1d is ~normal(0.5, 0.104): threshold exceeded `share` of the time
    share = min(max(share, 1e-4), 1.0 - 1e-4)
    return 0.5 + 0.104 * NormalDist().inv_cdf(1.0 - share)
def ss(e0, e1, x):
    t = min(max((x - e0) / (e1 - e0), 0.0), 1.0)
    return t * t * (3.0 - 2.0 * t)
if not n.evalParm(\"enable\"):
    return 0.0
f0 = hou.frame()
cov = n.evalParm(\"coverage\")
if cov <= 0.0:
    return 0.0
t0 = thr(cov)
gate = ss(t0, t0 + 0.02, ln(f0, max(1.0, round(n.evalParm(\"burst_rate\") * loopsec)), seed))
if gate <= 0.0:
    return 0.0
hzc = max(1.0, round(n.evalParm(\"stutter_hz\") * loopsec))
bright = 0.55 + 0.45 * ss(0.35, 0.65, ln(f0, hzc * 0.37, seed + 3.3))
return gate * bright
" language = python }
